---
layout: null
permalink: /sitemap.xml
sitemap: false
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- assign entries = site.html_pages | sort: 'url' -%}
{%- for entry in entries -%}
  {%- assign robots = entry.robots | default: '' | downcase -%}
  {%- if entry.lang and entry.sitemap != false and entry.redirect_to == nil -%}
    {%- unless robots contains 'noindex' -%}
      {%- capture modified -%}{%- include sitemap-lastmod.html entry=entry -%}{%- endcapture -%}
  <url>
    <loc>{{ entry.url | absolute_url | xml_escape }}</loc>
    {%- unless modified == empty %}
    <lastmod>{{ modified | xml_escape }}</lastmod>
    {%- endunless %}
  </url>
    {%- endunless -%}
  {%- endif -%}
{%- endfor %}
</urlset>
